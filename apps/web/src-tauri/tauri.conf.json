{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "codro",
  "version": "1.0.1",
  "identifier": "com.codro.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "category": "DeveloperTool",
    "copyright": "cozeed 2026",
    "externalBin": [],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "longDescription": "",
    "macOS": {
      "entitlements": null,
      "exceptionDomain": "",
      "frameworks": [],
      "providerShortName": null,
      "signingIdentity": null
    },
    "resources": [],
    "shortDescription": "",
    "targets": "all",
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": "",
      "nsis": {
        "installerIcon": "./icons/icon.ico"
      }
    }
  },
  "app": {
    "security": {
      "csp": null
    },
    "windows": [
      {
        "devtools": true,
        "fullscreen": false,
        "title": "codro",
        "center": true,
        "resizable": true,
        "dragDropEnabled": false,
        "maximizable": true,
        "minimizable": true,
        "decorations": false,
        "shadow": false,
        "transparent": true,
        "height": 800,
        "width": 1200
      }
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDY4OTczQzY4N0U0NDM0MkYKUldRdk5FUithRHlYYVA1L0VGNTlVQ0Z2ajFTQVY0blA4ZG5CQ1JEU2RjOGt5Wm1pbVA2QnVVTmQK",
      "endpoints": [
        "https://cdn.cozeed.com/releases/latest.json",
        "https://github.com/cozeed/codro/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
