{
  "name": "server",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsdown",
    "clean": "git clean -xdf .cache .turbo dist node_modules",
    "dev": "pnpm env:run tsx watch src/server.ts",
    "env:copy-example": "shx -- cp -n .env.example .env",
    "env:remove": "shx -- rm -f .env",
    "env:run": "dotenv --",
    "format": "prettier --check . --ignore-path ../../.gitignore",
    "lint": "eslint",
    "start": "NODE_ENV=production pnpm env:run node dist/server.mjs",
    "typecheck": "tsc --noEmit"
  },
  "prettier": "@workspace/prettier-config",
  "dependencies": {
    "@ai-sdk/anthropic": "^3.0.75",
    "@ai-sdk/deepseek": "^2.0.33",
    "@ai-sdk/google": "^3.0.68",
    "@ai-sdk/openai": "^3.0.62",
    "@assistant-ui/react-ai-sdk": "^1.3.23",
    "@aws-sdk/client-s3": "^3.1044.0",
    "@aws-sdk/s3-request-presigner": "^3.1044.0",
    "@hono/node-server": "^2.0.1",
    "@hono/trpc-server": "^0.4.2",
    "@workspace/api": "workspace:*",
    "@workspace/auth": "workspace:*",
    "@workspace/db": "workspace:*",
    "ai": "^6.0.175",
    "assistant-stream": "^0.3.13",
    "flydrive": "^2.1.0",
    "hono": "^4.12.18",
    "nanoid": "^5.1.11",
    "undici": "^8.2.0",
    "valibot": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "@workspace/eslint-config": "workspace:*",
    "@workspace/prettier-config": "workspace:*",
    "@workspace/typescript-config": "workspace:*",
    "dotenv-cli": "^11.0.0",
    "eslint": "^10.3.0",
    "prettier": "^3.8.3",
    "shx": "^0.4.0",
    "tsdown": "^0.22.0",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3"
  }
}
