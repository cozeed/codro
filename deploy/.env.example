# Database credentials
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=codro
# Server auth secret
SERVER_AUTH_SECRET=change-this-secret-in-production
# Server auth secret
SERVER_POSTGRES_URL=postgres://postgres:postgres@db:5432/codro
# Server host and port
SERVER_HOST=0.0.0.0
SERVER_PORT=3000
# Backend URL, used to configure OpenAPI (Scalar)
PUBLIC_SERVER_URL=http://localhost:3035
PUBLIC_SERVER_API_PATH=/api
# Frontend URL, used to configure trusted origin (cors)
PUBLIC_WEB_URL=http://localhost:8085
# This is the base URL for the assistant API.
PUBLIC_ASSISTANT_BASE_URL=https://proj-xxxxxxxxxxxx.assistant-api.com
# HTTP Proxy
# If your server is behind a HTTP proxy, set this to the proxy URL
HTTP_PROXY=
# google
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
# github
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret
# App encryption key, openssl rand -hex 32
APP_ENCRYPTION_KEY=288509617a0c5a4fa54458a11e3059864283346bd8e857c8be273643c976c1f5
# tavily
TAVILY_API_KEY=your_tavily_api_key_here
# Storage
DRIVE_DISK=fs
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=
R2_BUCKET=
R2_SUBDOMAIN=
AWS_S3_ACCESS_KEY_ID=
AWS_S3_SECRET_ACCESS_KEY=
AWS_S3_REGION=
AWS_S3_BUCKET=
AWS_S3_ENDPOINT=